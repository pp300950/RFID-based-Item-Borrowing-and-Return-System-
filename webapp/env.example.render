DB_MODE=bridge

DB_BRIDGE_URL=<URL จาก cloudflared ตอนรัน tunnel จริง เช่น https://xxxxx.trycloudflare.com>
DB_BRIDGE_KEY=<ต้องเป็นค่าเดียวกับ BRIDGE_AUTH_KEY ในไฟล์ที่ 1 เป๊ะ>

ADMIN_USERNAME=admin
ADMIN_PASSWORD=<ต้องเป็นค่าเดียวกับไฟล์ที่ 1>

JWT_SECRET=<ต้องเป็นค่าเดียวกับไฟล์ที่ 1>
JWT_EXPIRES_IN=7d

PORT=3000