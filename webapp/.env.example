# -----------------------------------------------------------------
# .env.example — คัดลอกเป็น .env แล้วกรอกค่าจริงของเครื่องตัวเอง
# ห้ามคอมมิต .env ตัวจริงเข้า git เด็ดขาด (ตรวจ .gitignore ว่ามี .env อยู่)
# -----------------------------------------------------------------

# MySQL / MariaDB (XAMPP) — ค่า default ของ XAMPP ทั่วไปคือ
# host=localhost, user=root, password="" (ว่าง) ก่อน production ควรตั้ง
# password ให้ root แล้วแก้ค่านี้ตาม
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=rfid_keys

# แอดมิน login (เปลี่ยนจากค่า default นี้ก่อนใช้งานจริงเสมอ)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin@1234

# JWT signing secret — สุ่มมาให้ใหม่แล้ว (openssl rand -hex 32)
# ใช้ได้เลย หรือจะสุ่มใหม่เองก็ได้ด้วยคำสั่งเดียวกัน
JWT_SECRET=f45b8af83253375b10ed286f5bc59075ee7e944b02e36a509580c868ffc15791

PORT=3000
