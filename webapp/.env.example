# -----------------------------------------------------------------
# .env.example — คัดลอกเป็น .env แล้วกรอกค่าจริงของเครื่องตัวเอง
# ห้ามคอมมิต .env ตัวจริงเข้า git เด็ดขาด (ตรวจ .gitignore ว่ามี .env อยู่)
# -----------------------------------------------------------------

# =========================================
# DATABASE (MySQL / MariaDB - XAMPP Local)
# =========================================
# ค่า default ของ XAMPP ทั่วไปคือ user=root, password="" (ว่าง)
# ก่อน production ควรตั้ง password ให้ root แล้วแก้ค่านี้ตาม
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=key_borrow_db

# =========================================
# TUNNEL (Cloudflare Tunnel หรือ ngrok)
# =========================================
# เลือก 1 ใน 2:
#
# 1️⃣  Cloudflare Tunnel (แนะนำ - ฟรี URL ถาวร ไม่เปลี่ยน)
#   วิธี: cloudflared tunnel --url http://localhost:3000
#   ได้ URL: https://xxxxx.trycloudflare.com
#
# 2️⃣  ngrok (ฟรีแต่ URL เปลี่ยนทุกครั้ง ต้องเปลี่ยน env ทุกครั้ง)
#   วิธี: ngrok http 3000
#   ได้ URL: https://abc123.ngrok.io
#
# ใช้ในการให้ Render เข้าถึง local server ผ่านอินเทอร์เน็ต
TUNNEL_URL=https://your-tunnel-url-here.trycloudflare.com

# =========================================
# JWT Authentication
# =========================================
# สุ่มมาให้ใหม่แล้ว (openssl rand -hex 32) ใช้ได้เลย
# หรือจะสุ่มใหม่เองก็ได้ด้วยคำสั่ง: openssl rand -hex 32
JWT_SECRET=f45b8af83253375b10ed286f5bc59075ee7e944b02e36a509580c868ffc15791
JWT_EXPIRES_IN=7d

# =========================================
# Admin Login (เปลี่ยนจากค่า default ก่อนใช้งานจริง)
# =========================================
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your-secure-password-here

# =========================================
# Line Notification (เจ้งเตือนการยืม-คืนกุญแจ)
# =========================================
# เลือกวิธี 1 ใน 2:
#
# 1️⃣  Line Notify (ส่งไปยังเบอร์โทรศัพท์เฉพาะ - ง่ายสุด)
#   ที่ได้ token: https://notify-bot.line.me/
#   ขั้นตอน:
#     1. เข้า https://notify-bot.line.me/
#     2. Login ด้วย Line account
#     3. สร้าง notification service ใหม่
#     4. Copy token มา paste ตรงนี้
#
# 2️⃣  Line Official Account (ส่งไปยัง OA - ซับซ้อนกว่า)
#   ที่ได้ token: https://manager.line.biz/
#   ต้องมี Line Business Account + Channel
#
# ใช้ LINE_NOTIFY_TOKEN สำหรับ Line Notify
# ใช้ LINE_OA_* สำหรับ Line Official Account
LINE_NOTIFY_TOKEN=your-line-notify-token-here
# LINE_OA_CHANNEL_ID=your-channel-id
# LINE_OA_CHANNEL_SECRET=your-channel-secret
# LINE_OA_ACCESS_TOKEN=your-access-token

# =========================================
# Express Server
# =========================================
PORT=3000
NODE_ENV=development

# =========================================
# Render Environment (สำหรับเมื่อ deploy ขึ้น Render)
# =========================================
# ตั้งค่าเดียวกัน ยกเว้น DB_HOST ชี้ไปที่ tunnel URL แทน localhost
# (ดูรายละเอียดใน README.md section 7)
