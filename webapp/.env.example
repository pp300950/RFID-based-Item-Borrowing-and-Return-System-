# =================================================================
# ไฟล์นี้คือไฟล์ "คีย์ลับ" ของระบบ — แยกออกจากโค้ดทั้งหมดโดยเจตนา
# ห้าม commit ไฟล์ .env (ตัวจริง) ขึ้น GitHub เด็ดขาด (.gitignore กันไว้ให้แล้ว)
#
# วิธีใช้ไฟล์นี้:
#   1. คัดลอกไฟล์นี้ แล้วเปลี่ยนชื่อเป็น ".env" (ตัดคำว่า .example ออก)
#   2. แทนที่ค่าตัวอย่างด้านล่างด้วยค่าจริงของคุณ ตามวิธีหาคีย์ที่อธิบายไว้
#   3. ไฟล์ .env ตัวจริงจะถูก .gitignore กันไว้ไม่ให้หลุดขึ้น Git อัตโนมัติ
#   4. เวลา deploy ขึ้น Render ให้ไปตั้งค่าตัวแปรพวกนี้ในหน้า
#      Render Dashboard > Environment แทน ไม่ต้องอัปโหลดไฟล์ .env ขึ้นไป
# =================================================================


# -----------------------------------------------------------------
# วิธีหาค่า SUPABASE_URL และ SUPABASE_SERVICE_ROLE_KEY
# -----------------------------------------------------------------
# 1. เข้า https://supabase.com แล้ว Sign in / สมัครสมาชิก (ใช้ GitHub login ก็ได้)
# 2. กด "New Project" ตั้งชื่อโปรเจกต์ (เช่น rfid-borrow-system)
#    เลือก Region ใกล้ไทยที่สุด (เช่น Singapore) แล้วตั้งรหัสผ่านฐานข้อมูล
#    (รหัสผ่านตรงนี้คือรหัส Postgres ไม่ใช่คีย์ที่จะเอามาใส่ไฟล์นี้ เก็บไว้เผื่อใช้)
# 3. รอสักครู่จนโปรเจกต์สร้างเสร็จ
# 4. ไปที่เมนูซ้าย -> "Project Settings" (รูปเฟือง) -> "API"
# 5. ในหน้านั้นจะเจอ:
#      - "Project URL"        -> เอามาใส่ค่า SUPABASE_URL ด้านล่าง
#      - "anon public" key    -> ใช้ฝั่ง frontend เท่านั้น (ไม่ต้องใช้ในไฟล์นี้ตอนนี้)
#      - "service_role" key   -> เอามาใส่ค่า SUPABASE_SERVICE_ROLE_KEY ด้านล่าง
#        **คีย์ตัวนี้มีสิทธิ์เต็ม ห้ามใส่ในโค้ดฝั่ง frontend หรือเผยแพร่ที่ไหนเด็ดขาด**
#        ใช้ได้แค่ฝั่ง server (โค้ดในไฟล์นี้ทำงานฝั่ง server เท่านั้น จึงปลอดภัย)
# -----------------------------------------------------------------

SUPABASE_URL=https://zjvdxddyebzqsnqevpxq.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sb_secret_D-XE37F73YbdHalZadsUnQ_DIqF15sg


# -----------------------------------------------------------------
# บัญชีแอดมิน (hardcode ไว้ในระบบ ไม่ได้เก็บในฐานข้อมูล)
# เปลี่ยนค่าพวกนี้ก่อนใช้งานจริงเสมอ
# -----------------------------------------------------------------
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin@RFID2026


# -----------------------------------------------------------------
# พอร์ตที่ใช้รันเซิร์ฟเวอร์ (ตอน deploy บน Render ไม่ต้องตั้งเอง
# Render จะกำหนดค่า PORT ให้อัตโนมัติผ่าน environment variable นี้)
# -----------------------------------------------------------------
PORT=3000
