# --- ต่อ MySQL ตรง (server.js หลักที่รันบนคอมใช้ค่านี้) ---
DB_HOST=localhost
DB_USER=app_user
DB_PASSWORD=<รหัสผ่านจริงที่ตั้งตอนสร้าง app_user ใน MySQL>
DB_NAME=key_borrow_db
DB_PORT=3306

# --- โหมด: คอม local ใช้ local เสมอ ---
DB_MODE=local

# --- bridge-server.js อ่านค่าพวกนี้ตอนมันสตาร์ท ---
BRIDGE_PORT=4001
BRIDGE_AUTH_KEY=<สุ่มเอง เช่น openssl rand -hex 32>

# --- DB_BRIDGE_URL / DB_BRIDGE_KEY: ไม่ต้องตั้งฝั่งนี้เลย ---
# (สองตัวนี้ใช้เฉพาะฝั่งที่ "เรียก" bridge คือ Render เท่านั้น
#  คอม local เป็นฝั่ง "รับ" ไม่ใช่ฝั่ง "เรียก")

ADMIN_USERNAME=admin
ADMIN_PASSWORD=<เปลี่ยนจาก admin@1234 เป็นรหัสจริงของตัวเอง>

JWT_SECRET=<ใช้ค่าที่ให้มาในไฟล์ตัวอย่างได้ หรือสุ่มใหม่เอง>
JWT_EXPIRES_IN=7d

PORT=3000